# SAAHAA · .env.deploy — credentials for tools/deploy.sh. NEVER COMMITTED.
#
# Copy to `.env.deploy` and fill in. Everything here is free-tier; nothing in
# this file can put you on a paid plan. docs/FREE-TIER.md is the accounting.

# ── Supabase ──────────────────────────────────────────────────
# Project → Settings → Database → Connection string → URI (session pooler).
# Substitute your database password for [YOUR-PASSWORD].
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Project → Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # public — also baked into the build
SUPABASE_SERVICE_KEY=eyJ...         # MASTER KEY. Worker secret only. Never in git, never in a browser.

# ── Cloudflare ────────────────────────────────────────────────
# My Profile → API Tokens → Create Token. It needs exactly three permissions:
#   Account · Workers Scripts · Edit
#   Account · Cloudflare Pages · Edit
#   User    · Memberships     · Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=              # dashboard sidebar

# ── the rest ──────────────────────────────────────────────────
PAGES_PROJECT=saahaa
ADMIN_CODES=C20262001               # comma-separated; who may clear money
HOOK_SECRET=                        # leave blank and deploy.sh mints one, once
NOTIFY_URL=                         # optional: Telegram/Slack hook for claims

# Filled in after the first deploy so `--check` can verify them.
WORKER_URL=
PAGES_URL=

# The owner console password, so the roster can be read. Optional.
ADMIN_PASSWORD=
